# Copy this file to .env.local and fill in the real values.
# Never commit .env.local. Ask the maintainer for the keys privately.

# ── This repo's shared settings (safe defaults, no secrets) ───────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How the frontend talks to the backend: "mock" (default) or "live".
NEXT_PUBLIC_API_MODE=live

# ── Backend (server-only unless prefixed NEXT_PUBLIC_) ────────────────────────
# Apply supabase/migrations/0001_init.sql, 0002_portal.sql, and 0003_admin_cms_payment_ai.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Registration switch (mirror siteConfig.registrationOpen).
REGISTRATION_OPEN=true

# Kickoff (T0): 17 January 2027, 10:00 IST (Event dates: 17–18 January 2027).
EVENT_START_ISO=2027-01-17T10:00:00+05:30
# Optional exact overrides (ISO timestamps) of the derived schedule.
REGISTRATION_OPENS_AT=
REGISTRATION_CLOSES_AT=
TEAM_LOCK_AT=

# SHA-256 of the published rulebook, stored with each registration's consent.
RULEBOOK_SHA256=

# Reject gmail/yahoo/outlook etc. as "institutional" emails (rulebook 3.5).
BLOCK_FREE_EMAIL_DOMAINS=true

# Max college ID / payment proof size in bytes (default 4 MB).
MAX_ID_BYTES=4194304

# Long random secret used to hash client IPs for rate limiting.
IP_HASH_SALT=

# OC admin API (Authorization: Bearer ...). Required for /admin and /api/admin/*.
ADMIN_API_TOKEN=

# Retention job (/api/cron/retention).
CRON_SECRET=
RETENTION_PURGE_ENABLED=false

# Optional Slack/Discord-compatible webhook. Receives ids and counts only.
OC_NOTIFY_WEBHOOK_URL=

# ── Portal & Judging phase (migrations 0002 & 0003) ───────────────────────────
# Named OC tokens with roles (oc, technical, moderator, chair), separated by ';':
#   ADMIN_TOKENS=Asha:oc:<token>;Ravi:technical:<token>;Meera:moderator:<token>
ADMIN_TOKENS=

# Transactional email (Resend-compatible API) for payment-gated registration
# confirmation emails and portal keys.
RESEND_API_KEY=
MAIL_FROM=

# Organiser-side scoring service for the Advanced benchmark (optional).
EVAL_SERVICE_URL=
EVAL_SERVICE_TOKEN=

# Secret for per-team problem seeds and canary records.
TEAM_SEED_SECRET=
