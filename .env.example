# Copy this file to .env.local and fill in the real values.
# Never commit .env.local. Ask the maintainer for the keys privately.

# ── This repo's shared settings (safe defaults, no secrets) ───────────────────
# Public base URL of the site, used for canonical URLs, the sitemap, robots.txt,
# the web manifest and Open Graph/Twitter previews. Include no trailing slash.
# Safe default for local development; set to the production URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How the frontend talks to the backend: "mock" (default) or "live".
#   mock — no network traffic. The register and contact forms wait briefly and
#          resolve with a successful, obviously-fake response.
#   live — forms POST JSON to the backend at /api/register and /api/contact.
# The frontend never sends the college ID file; upload is owned by the backend.
NEXT_PUBLIC_API_MODE=mock

# ── Backend (server-only unless prefixed NEXT_PUBLIC_) ────────────────────────
# Supabase project. Apply supabase/migrations/0001_init.sql first.
# The service-role key bypasses row level security: server only, never commit.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Registration is CLOSED unless this is true (mirror siteConfig.registrationOpen).
REGISTRATION_OPEN=false

# Kickoff (T0), e.g. 2026-12-14T10:00:00+05:30. Leave empty while dates are TBA.
# When set, the rulebook schedule is enforced: registration opens D-14, closes
# at the end of D-5, teams lock D-3 (college ID uploads stop), and personal data
# is purged 180 days after final results (T+144 h).
EVENT_START_ISO=
# Optional exact overrides (ISO timestamps) of the derived schedule.
REGISTRATION_OPENS_AT=
REGISTRATION_CLOSES_AT=
TEAM_LOCK_AT=

# SHA-256 of the published rulebook, stored with each registration's consent.
RULEBOOK_SHA256=

# Reject gmail/yahoo/outlook etc. as "institutional" emails (rulebook 3.5).
BLOCK_FREE_EMAIL_DOMAINS=true

# Max college ID size in bytes (default 4 MB, below typical serverless body
# limits). If you raise it, raise the bucket's file_size_limit too.
MAX_ID_BYTES=4194304

# Long random secret used to hash client IPs for rate limiting (no raw IPs stored).
IP_HASH_SALT=

# OC admin API (Authorization: Bearer ...). Leave empty to disable /api/admin/*.
ADMIN_API_TOKEN=

# Retention job (/api/cron/retention). Vercel Cron sends CRON_SECRET as a bearer token.
CRON_SECRET=
RETENTION_PURGE_ENABLED=false

# Optional Slack/Discord-compatible webhook. Receives ids and counts only.
OC_NOTIFY_WEBHOOK_URL=

# ── Portal phase (migration 0002) ─────────────────────────────────────────────
# Named OC tokens with roles (oc, technical, moderator, chair), separated by ';':
#   ADMIN_TOKENS=Asha:oc:<token>;Ravi:technical:<token>;Meera:moderator:<token>
# `oc` can do everything. ADMIN_API_TOKEN above keeps working as a role-"oc" token.
# Generate tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKENS=

# Transactional email (Resend-compatible API) for portal keys. Without both, keys are
# returned to the OC once when a team is verified, to hand over manually.
RESEND_API_KEY=
MAIL_FROM=

# Organiser-side scoring service for the Advanced benchmark (see lib/eval.ts). Optional.
EVAL_SERVICE_URL=
EVAL_SERVICE_TOKEN=

# Secret for per-team problem seeds and canary records. Keep it stable for the whole event.
TEAM_SEED_SECRET=
